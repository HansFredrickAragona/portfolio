# Resend API key used for contact delivery.
RESEND_API_KEY=re_your_api_key

# Inbox that receives contact messages.
CONTACT_EMAIL=you@example.com

# Optional sender override. Defaults to Resend's onboarding test sender.
# For a custom sender, use an address on a domain verified in Resend.
# CONTACT_FROM_EMAIL="Portfolio <contact@your-verified-domain.com>"
